      "messages": [
        {
          "role": "assistant",
          "content": "大夫，我肚子左上边这块儿疼。"
        },
        {
          "role": "user",
          "content": "哪里疼？"
        },
        {
          "role": "assistant",
          "content": "我左上腹痛。"
        },
        {
          "role": "user",
          "content": "腹痛多久了？"
        },
        {
          "role": "assistant",
          "content": "疼了两三天了。"
        },
        {
          "role": "user",
          "content": "疼痛是什么性质？"
        },
        {
          "role": "assistant",
          "content": "主要是胀痛。"
        },
        {
          "role": "user",
          "content": "进食后腹痛会加重吗？吃油腻食物后呢？"
        },
        {
          "role": "assistant",
          "content": "进食后腹痛会加重，吃油腻的食物后更明显。"
        },
        {
          "role": "user",
          "content": "按压会加重吗？"
        },
        {
          "role": "assistant",
          "content": "按压后腹痛会加重。"
        },
        {
          "role": "user",
          "content": "疼痛向其他地方放射吗？有没有腹胀？"
        },
        {
          "role": "assistant",
          "content": "疼痛没有向其他地方放射。有腹胀。"
        },
        {
          "role": "user",
          "content": "怕冷还是怕热？有没有发热？出汗多吗？"
        },
        {
          "role": "assistant",
          "content": "我怕热，没有畏寒、恶寒，也没有发热。比较容易出汗。"
        },
        {
          "role": "user",
          "content": "平时胃口怎么样？这两天能进食吗？"
        },
        {
          "role": "assistant",
          "content": "平时饮食还可以，这两天不能进食。"
        },
