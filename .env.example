PORT=3001
OPENAPI_BASE_URL=https://api.coze.cn
OPENAPI_TOKEN=your-coze-api-token
PATIENT_VOICE_ID=7568423452617588790
PATIENT_BOT_ID=your-coze-bot-id
# Optional: a separate evaluator bot for source-grounded review of teacher-approved checks.
EVALUATION_BOT_ID=

# Cloud encounter records: use a public key only; never put a service_role/secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon JWT is also supported when SUPABASE_PUBLISHABLE_KEY is empty.
SUPABASE_ANON_KEY=

# Independent Chaoxing SSO. These secrets are read only by the server.
SSO_CENTER_URL=https://sdtqvk3ybm.coze.site
APP_PUBLIC_URL=
SSO_SHARED_SECRET=
SSO_SESSION_SECRET=
# Keep this separate identity-mapping secret stable across deployments.
SSO_IDENTITY_SECRET=
# Used only by the SSO bridge, never by student record requests or public config.
SUPABASE_SERVICE_ROLE_KEY=
